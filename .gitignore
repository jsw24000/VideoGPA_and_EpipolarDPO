# Local Python/runtime caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# Local environments and secrets
.env
.env.*
*.pem
*.key
*.token

# Large model weights and checkpoints
/models/*
!/models/README.md
!/models/.gitkeep
/checkpoints/
**/checkpoints/
*.ckpt
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.gguf

# Generated media and experiment outputs
/outputs/*
!/outputs/README.md
!/outputs/.gitkeep
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.gif

# Large DL3DV assets kept outside git
/data/first_frames/*
!/data/first_frames/.gitkeep
/data/manifests/*
!/data/manifests/.gitkeep
/data/logs/*
!/data/logs/.gitkeep
/data/reports/generated/*
!/data/reports/generated/.gitkeep
/data/reports/*.json
/data/reports/*.jsonl
/data/reports/*.md
!/data/reports/README.md
/data/validation/*
!/data/validation/.gitkeep
/data/dl3dv_raw_960p/
/data/download_cache/
/data/staging/

# Host-local storage config
/configs/data/storage.local.yaml
/data/configs/storage.local.yaml

# Temporary/incomplete downloads
*.partial
*.tmp
*.temp

/data/first_frames.tar
