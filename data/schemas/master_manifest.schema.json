{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DL3DV portable condition master manifest record",
  "type": "object",
  "required": [
    "record_version",
    "scene_uid",
    "scene_id",
    "split",
    "source_subset",
    "caption_source",
    "caption_source_file",
    "caption_source_key",
    "vlm_caption_raw",
    "vlm_caption",
    "first_frame_relpath",
    "first_frame_sha256",
    "first_frame_width",
    "first_frame_height",
    "scripted_camera_seed",
    "scripted_camera_motion",
    "scripted_i2v_text_prompt",
    "i2v_train_text_prompt",
    "t2v_train_text_prompt",
    "i2v_test_text_prompt",
    "t2v_test_text_prompt"
  ],
  "properties": {
    "record_version": {"const": 1},
    "scene_uid": {"type": "string"},
    "scene_id": {"type": "string"},
    "split": {"enum": ["train", "test"]},
    "source_subset": {"enum": ["1K", "8K", "9K", "10K", "11K"]},
    "caption_source": {"type": "string"},
    "caption_source_file": {"type": "string"},
    "caption_source_key": {"type": "string"},
    "vlm_caption_raw": {"type": "string"},
    "vlm_caption": {"type": "string", "minLength": 1},
    "first_frame_relpath": {"type": ["string", "null"]},
    "first_frame_sha256": {"type": ["string", "null"]},
    "first_frame_width": {"type": ["integer", "null"]},
    "first_frame_height": {"type": ["integer", "null"]},
    "scripted_camera_seed": {"type": "integer"},
    "scripted_camera_motion": {"type": "string"},
    "scripted_i2v_text_prompt": {"type": "string"},
    "i2v_train_text_prompt": {"type": ["string", "null"]},
    "t2v_train_text_prompt": {"type": ["string", "null"]},
    "i2v_test_text_prompt": {"type": ["string", "null"]},
    "t2v_test_text_prompt": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
